        </div>
    </div>

    <script>
        const BASE_URL = window.location.origin;
        
        async function sendKey(key) {
            logMessage(`Sending key: ${key}`);
            try {
                const response = await fetch(`${BASE_URL}/key/${key}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                const result = await response.json();
                if (result.success) {
                    logMessage(`✓ Key sent: ${key}`);
                } else {
                    logMessage(`✗ Failed to send key: ${key}`);
                }
            } catch (error) {
                logMessage(`✗ Error: ${error.message}`);
            }
        }
        
        function changeChannel() {
            const channelInput = document.getElementById('channel-input');
            const channel = channelInput.value.trim();
            
            if (!channel || isNaN(channel)) {
                logMessage('Please enter a valid channel number');
                return;
            }
            
            // Clear the input field
            channelInput.value = '';
            
            // Send each digit individually
            for (let digit of channel) {
                sendKey(`KEY_${digit}`);
            }
            
            // Press ENTER after entering the channel
            setTimeout(() => {
                sendKey('KEY_ENTER');
            }, 500);
        }
        
        function openBrowser() {
            logMessage('Opening browser on TV...');
            // This would typically be handled by a special endpoint
