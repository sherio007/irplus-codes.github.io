        </div>
        
        <div style="text-align: center; margin: 20px 0;">
            <button onclick="openBrowser()" style="padding: 15px; font-size: 18px; background: #28a745; color: white; border: none; border-radius: 5px; cursor: pointer;">🌐 Open Browser</button>
        </div>
        
