</head>
<body>
    <div class="remote-container">
        <h1>📺 Samsung TV Remote Control</h1>
        
        <div class="info-panel">
            <strong>TV IP:</strong> 192.168.23.25<br>
            <strong>Status:</strong> <span id="tv-status">Connecting...</span>
