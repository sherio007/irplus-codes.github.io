                fetch(`${BASE_URL}/launch/org.tizen.browser?metaTag=http://192.168.23.20:8080/control.html`)
                    .then(r => r.json())
                    .then(result => logMessage(result.success ? 'Browser opened!' : 'Failed to open browser'));
            }, 1000);
        }
        
        function logMessage(message) {
            const logArea = document.getElementById('log-area');
            const timestamp = new Date().toLocaleTimeString();
            logArea.value += `[${timestamp}] ${message}\\n`;
            logArea.scrollTop = logArea.scrollHeight;
        }
        
        // Check connection status
        fetch(`${BASE_URL}/status`)
            .then(response => response.json())
            .then(data => {
                document.getElementById('tv-status').textContent = 'Ready';
                logMessage('Remote control ready!');
            })
            .catch(error => {
                document.getElementById('tv-status').textContent = 'Error connecting';
                logMessage(`Connection error: ${error.message}`);
            });
        
        // Allow pressing Enter in channel input
        document.getElementById('channel-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                changeChannel();
            }
        });
    </script>
</body>
</html>'''
                self._send_response(200, html_content)
            else:
                self._send_response(404, {"error": "Not found"})

async def start_websocket_server():
    """Initialize and run the TV controller"""
    print("Initializing TV controller...")
    await tv_controller.connect_to_tv()

def run_server():
    """Run the HTTP server in a separate thread"""
    server_address = ('', 8080)
    httpd = HTTPServer(server_address, RequestHandler)
    print("🚀 Server running on port 8080")
    print("🌐 Access the remote at: http://localhost:8080 or http://192.168.23.20:8080")
    httpd.serve_forever()

if __name__ == "__main__":
    # Start the WebSocket connection first
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    
    # Initialize the TV connection
    loop.run_until_complete(start_websocket_server())
    
    # Start the HTTP server in a separate thread
    server_thread = threading.Thread(target=run_server, daemon=True)
    server_thread.start()
    
    print("\n✅ TV Control Bridge is running!")
    print("📋 Usage:")
    <REDACTED_EMAIL>
    print("   - Web interface: http://localhost:8080 or http://192.168.23.20:8080")
    print("   - Send key: GET request to /key/{KEY_NAME}")
    print("   - Example: http://localhost:8080/key/KEY_MENU")
    
    try:
        # Keep the main thread alive
        while True:
            loop.run_forever()
    except KeyboardInterrupt:
        print("\n👋 Shutting down TV Control Bridge...")