            <button class="key-btn" onclick="sendKey('KEY_UP')">↑</button>
            <button class="key-btn" onclick="sendKey('KEY_CH_LIST')">CH LIST</button>
            <button class="key-btn" onclick="sendKey('KEY_DOWN')">↓</button>
            
            <button class="key-btn" onclick="sendKey('KEY_LEFT')">←</button>
            <button class="key-btn" onclick="sendKey('KEY_ENTER')">OK</button>
            <button class="key-btn" onclick="sendKey('KEY_RIGHT')">→</button>
            
            <button class="key-btn" onclick="sendKey('KEY_VOLUP')">Vol +</button>
            <button class="key-btn" onclick="sendKey('KEY_MUTE')">Mute</button>
            <button class="key-btn" onclick="sendKey('KEY_VOLDOWN')">Vol -</button>
            
            <button class="key-btn" onclick="sendKey('KEY_CHUP')">CH +</button>
            <button class="key-btn" onclick="sendKey('KEY_MENU')">Menu</button>
            <button class="key-btn" onclick="sendKey('KEY_CHDOWN')">CH -</button>
            
            <button class="key-btn" onclick="sendKey('KEY_1')">1</button>
            <button class="key-btn" onclick="sendKey('KEY_2')">2</button>
            <button class="key-btn" onclick="sendKey('KEY_3')">3</button>
            
            <button class="key-btn" onclick="sendKey('KEY_4')">4</button>
            <button class="key-btn" onclick="sendKey('KEY_5')">5</button>
            <button class="key-btn" onclick="sendKey('KEY_6')">6</button>
            
            <button class="key-btn" onclick="sendKey('KEY_7')">7</button>
            <button class="key-btn" onclick="sendKey('KEY_8')">8</button>
            <button class="key-btn" onclick="sendKey('KEY_9')">9</button>
            
            <button class="key-btn" onclick="sendKey('KEY_PREVIOUS')">Prev</button>
            <button class="key-btn" onclick="sendKey('KEY_0')">0</button>
            <button class="key-btn" onclick="sendKey('KEY_RETURN')">Return</button>
        </div>
        
        <div style="text-align: center; margin: 20px 0;">
            <input type="text" id="channel-input" class="channel-input" placeholder="Channel" maxlength="4">
            <button onclick="changeChannel()">Set Channel</button>
        </div>
        
        <div class="volume-control">
