#!/usr/bin/env python3
"""
Samsung TV Control Bridge
Provides a web server to control Samsung TV via HTTP requests
"""

import asyncio
import websockets
import json
import threading
from http.server import HTTPServer, BaseHTTPRequestHandler
import urllib.parse
import ssl
import socket

TV_IP = '192.168.23.25'
MY_TOKEN = '78091086'
NAME = 'Master_Controller'

class TVController:
    def __init__(self):
        self.ws_connection = None
    
    async def connect_to_tv(self):
        """Connect to Samsung TV via WebSocket"""
        uri = f"wss://{TV_IP}:8002/api/v2/channels/samsung.remote.control?name={NAME}&token={MY_TOKEN}"
        
        # Create SSL context that ignores certificate verification
        ssl_context = ssl.create_default_context()
        ssl_context.check_hostname = False
        ssl_context.verify_mode = ssl.CERT_NONE
        
        try:
            self.ws_connection = await websockets.connect(
                uri, 
                extra_headers={"Origin": "http://localhost"},
                ssl=ssl_context
            )
            print(f"✅ Connected to TV at {TV_IP}")
            return True
        except Exception as e:
            print(f"❌ Failed to connect to TV: {e}")
            return False
    
    async def send_key(self, key):
        """Send a key command to the TV"""
        if not self.ws_connection:
            if not await self.connect_to_tv():
                return False
        
        payload = {
            "method": "ms.channel.emit",
            "params": {
                "event": "ed.remote.control",
                "to": "host",
                "data": {
                    "type": "method",
                    "key": key,
                    "base64": "false"
                }
            }
        }
        
        try:
            await self.ws_connection.send(json.dumps(payload))
            print(f"✅ Sent key: {key}")
            return True
        except Exception as e:
            print(f"❌ Failed to send key {key}: {e}")
            # Try to reconnect
            self.ws_connection = None
            if await self.connect_to_tv():
                await self.ws_connection.send(json.dumps(payload))
                print(f"✅ Sent key after reconnection: {key}")
                return True
            return False
    
    async def launch_app(self, app_id, meta_tag=""):
        """Launch an app on the TV"""
        if not self.ws_connection:
            if not await self.connect_to_tv():
                return False
        
        payload = {
            "method": "ms.channel.emit",
            "params": {
                "event": "ed.apps.launch",
                "to": "host",
                "data": {
                    "appId": app_id,
                    "action_type": "NATIVE_LAUNCH",
                    "metaTag": meta_tag
                }
            }
        }
        
        try:
            await self.ws_connection.send(json.dumps(payload))
            print(f"✅ Launched app: {app_id}")
            return True
        except Exception as e:
            print(f"❌ Failed to launch app {app_id}: {e}")
            return False

# Global TV controller instance
tv_controller = TVController()

class RequestHandler(BaseHTTPRequestHandler):
    def _send_response(self, status_code, response_data):
        """Send HTTP response"""
        self.send_response(status_code)
        self.send_header('Content-type', 'application/json')
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
        self.end_headers()
        
        if isinstance(response_data, dict):
            self.wfile.write(json.dumps(response_data).encode())
        else:
            self.wfile.write(response_data.encode())
    
    def do_OPTIONS(self):
        """Handle preflight CORS requests"""
        self._send_response(200, {"status": "OK"})
    
    def do_GET(self):
        """Handle GET requests for TV control"""
        parsed_path = urllib.parse.urlparse(self.path)
        path_parts = parsed_path.path.strip('/').split('/')
        
        if path_parts[0] == 'key':
            if len(path_parts) > 1:
                key = path_parts[1]
                print(f"Received key request: {key}")
                
                # Handle the request asynchronously
                async def handle_key():
                    success = await tv_controller.send_key(key)
                    return {"success": success, "key": key}
                
                # Run the async function
                loop = asyncio.new_event_loop()
                asyncio.set_event_loop(loop)
                result = loop.run_until_complete(handle_key())
                loop.close()
                
                self._send_response(200, result)
            else:
                self._send_response(400, {"error": "No key specified"})
        elif path_parts[0] == 'launch':
            if len(path_parts) > 1:
                app_id = path_parts[1]
                query_params = urllib.parse.parse_qs(parsed_path.query)
                meta_tag = query_params.get('metaTag', [''])[0]
                
                async def handle_launch():
                    success = await tv_controller.launch_app(app_id, meta_tag)
                    return {"success": success, "app_id": app_id, "meta_tag": meta_tag}
                
                loop = asyncio.new_event_loop()
                asyncio.set_event_loop(loop)
                result = loop.run_until_complete(handle_launch())
                loop.close()
                
                self._send_response(200, result)
            else:
                self._send_response(400, {"error": "No app ID specified"})
        elif self.path == '/status':
            self._send_response(200, {"status": "running", "tv_ip": TV_IP})
        else:
            # Serve the control HTML page if requesting root
            if self.path == '/' or self.path == '/control.html':
                html_content = '''
<!DOCTYPE html>
<html lang="en">
